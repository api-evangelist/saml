        {
          "id": "db06a70c-5875-492b-a228-fbfc5e32b3aa",
          "name": "SSO HTTP Redirect Binding",
          "request": {
            "name": "SSO HTTP Redirect Binding",
            "description": {
              "content": "Initiates SAML 2.0 Single Sign-On using the HTTP Redirect Binding (Section 3.4 of saml-bindings-2.0-os). The AuthnRequest is encoded, deflated, and base64-encoded as a query parameter. The Identity Provider processes the request and responds with an authentication challenge or redirects back to the Service Provider with a SAML Response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "saml",
                "sso",
                "redirect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "SAMLRequest",
                  "value": "<string>",
                  "description": "(Required) The deflated, base64-encoded, and URL-encoded SAML AuthnRequest XML message. The message MUST be deflated using the DEFLATE compression method (RFC 1951) before base64 encoding."
                },
                {
                  "disabled": false,
                  "key": "RelayState",
                  "value": "<string>",
                  "description": "An opaque reference to state information maintained at the Service Provider. The value MUST NOT exceed 80 bytes in length and MUST be integrity-protected by the entity creating it."
                },
                {
                  "disabled": false,
                  "key": "SigAlg",
                  "value": "<uri>",
                  "description": "The URI identifying the signature algorithm used to sign the request. Required when the request is signed."
                },
                {
                  "disabled": false,
                  "key": "Signature",
                  "value": "<string>",
                  "description": "The base64-encoded and URL-encoded signature value computed over the SAMLRequest, RelayState (if present), and SigAlg query string parameters."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
